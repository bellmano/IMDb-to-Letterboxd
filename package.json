{
  "name": "imdb-to-letterboxd",
  "version": "1.0.0",
  "description": "Browser extension that allows you to quickly navigate from an IMDb movie page to the corresponding Letterboxd page with one click",
  "scripts": {
    "test": "vitest run --globals --environment jsdom",
    "test:coverage": "vitest run --globals --environment jsdom --coverage --coverage.provider=istanbul --coverage.include=src/background.js --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^5.1.0",
    "jsdom": "^31.0.0",
    "vitest": "^5.1.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "argparse": "^2.0.1"
  }
}
